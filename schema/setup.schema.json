{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://setup-as-code.local/setup.schema.json",
  "title": "setup.yaml - declarative personal AI assistant setup",
  "type": "object",
  "required": ["version", "meta"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["instance"],
      "properties": {
        "instance": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "description": { "type": "string" },
        "owner_role": { "type": "string" },
        "generated_at": { "type": "string" },
        "generated_by": { "type": "string" }
      }
    },
    "vars": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "import": {
      "type": "object",
      "properties": {
        "importers": { "oneOf": [{ "const": "all" }, { "type": "array", "items": { "type": "string" } }] },
        "options": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },

    "identity": {
      "type": "object",
      "properties": {
        "person": {
          "type": "object",
          "properties": {
            "role": { "type": "string" },
            "display_name": { "type": "string" },
            "timezone": { "type": "string" },
            "languages": { "type": "array", "items": { "type": "string" } },
            "profile_refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "accounts": { "type": "array", "items": { "$ref": "#/definitions/account" } }
      }
    },

    "brain": {
      "type": "object",
      "properties": {
        "claude_code": { "type": "object" },
        "runtimes": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "roster": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "gates": { "type": "array", "items": { "$ref": "#/definitions/gate" } },
        "budgets": { "type": "object" }
      }
    },

    "instructions": {
      "type": "object",
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } },
        "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
      }
    },

    "tools": {
      "type": "object",
      "properties": {
        "mcp_servers": { "type": "array", "items": { "$ref": "#/definitions/mcpServer" } },
        "skills": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "plugins": { "type": "array", "items": { "$ref": "#/definitions/plugin" } },
        "hooks": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
        "commands": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "permissions": {
          "type": "object",
          "properties": {
            "default_mode": { "type": "string" },
            "allow": { "$ref": "#/definitions/stringList" },
            "deny": { "$ref": "#/definitions/stringList" },
            "ask": { "$ref": "#/definitions/stringList" }
          },
          "additionalProperties": false
        },
        "denied_mcp_servers": { "$ref": "#/definitions/stringList" }
      }
    },

    "loops": { "type": "array", "items": { "$ref": "#/definitions/loop" } },

    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": { "type": "array", "items": { "$ref": "#/definitions/channel" } },
        "email": { "type": "array", "items": { "$ref": "#/definitions/channel" } },
        "social": { "type": "array", "items": { "$ref": "#/definitions/channel" } },
        "calendar": { "type": "array", "items": { "$ref": "#/definitions/channel" } },
        "todo": { "type": "array", "items": { "$ref": "#/definitions/channel" } },
        "journal": { "type": "array", "items": { "$ref": "#/definitions/channel" } }
      }
    },

    "projects": { "type": "array", "items": { "$ref": "#/definitions/project" } },

    "business": {
      "type": "object",
      "properties": { "lanes": { "type": "array", "items": { "$ref": "#/definitions/lane" } } }
    },

    "data": {
      "type": "object",
      "properties": {
        "memory": { "type": "object" },
        "state": { "type": "array", "items": { "$ref": "#/definitions/stateItem" } },
        "references": { "type": "array", "items": { "$ref": "#/definitions/idItem" } }
      }
    },

    "infra": {
      "type": "object",
      "properties": {
        "machine": { "type": "object" },
        "clis": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "repos": { "type": "array", "items": { "$ref": "#/definitions/idItem" } },
        "services": { "type": "array", "items": { "$ref": "#/definitions/idItem" } }
      }
    },

    "safety": {
      "type": "object",
      "properties": {
        "policies": { "type": "array", "items": { "$ref": "#/definitions/policy" } }
      }
    }
  },

  "definitions": {
    "id": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "idItem": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/definitions/id" } }
    },
    "account": {
      "type": "object",
      "required": ["id", "kind", "access"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "kind": { "type": "string" },
        "role": { "type": "string" },
        "principal": { "type": "string" },
        "workspace": { "type": "string" },
        "credential_ref": { "type": "string", "description": "Where the secret lives (file path, keychain item, env var NAME). Never the value." },
        "path": { "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/stringList" }] },
        "scopes": { "$ref": "#/definitions/stringList" },
        "access": { "enum": ["can_post", "read_only", "forbidden", "unknown"] },
        "note": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "applies_to"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "model": { "type": "string" },
        "runtime": { "type": "string" },
        "threshold": { "type": "string" },
        "applies_to": { "$ref": "#/definitions/stringList" },
        "tools": { "$ref": "#/definitions/stringList" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "path": { "type": "string" },
        "kind": { "enum": ["global", "import", "project", "memory", "manual"] }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "scope", "severity", "date", "reason"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "scope": { "type": "string" },
        "severity": { "enum": ["hard", "standing"] },
        "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string" },
        "statement": { "type": "string" },
        "source": { "type": "string" },
        "status": { "enum": ["active", "superseded"] },
        "enforced_by": { "$ref": "#/definitions/stringList" }
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "source": { "type": "string" },
        "transport": { "enum": ["stdio", "http", "sse", "connector", "plugin", "unknown"] },
        "command": { "type": "string" },
        "args": { "$ref": "#/definitions/stringList" },
        "url": { "type": "string" },
        "env_names": { "$ref": "#/definitions/stringList" },
        "header_names": { "$ref": "#/definitions/stringList" },
        "enabled": { "type": "boolean" }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "enabled": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "version": { "type": "string" }
      }
    },
    "hook": {
      "type": "object",
      "required": ["id", "event", "command"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "event": { "type": "string" },
        "matcher": { "type": "string" },
        "command": { "type": "string" }
      }
    },
    "loop": {
      "type": "object",
      "required": ["id", "runner", "enabled"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "runner": { "enum": ["launchd", "cron", "systemd", "manual", "cloud"] },
        "enabled": { "type": "boolean" },
        "status": { "type": "string" },
        "schedule": { "type": "object" },
        "program": { "$ref": "#/definitions/stringList" },
        "working_dir": { "type": "string" },
        "log": { "type": "string" },
        "env_names": { "$ref": "#/definitions/stringList" },
        "owner": { "type": "string" },
        "managed": { "type": "boolean" },
        "success_metric": { "type": "string" },
        "brain": { "type": "object" },
        "files": { "$ref": "#/definitions/stringList" },
        "note": { "type": "string" }
      }
    },
    "channel": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "kind": { "type": "string" },
        "platform": { "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/stringList" }] },
        "identity": { "type": "string" },
        "gate": { "type": "string" },
        "status": { "type": "string" },
        "active": { "type": "boolean" },
        "role": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "path": { "type": "string" },
        "source": { "type": "string" },
        "lane": { "type": "string" }
      }
    },
    "lane": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "status": { "enum": ["active", "paused", "halted", "killed", "blocked", "planned"] },
        "goal": { "type": "string" },
        "metric": { "type": "string" },
        "loops": { "$ref": "#/definitions/stringList" },
        "channels": { "$ref": "#/definitions/stringList" },
        "projects": { "$ref": "#/definitions/stringList" },
        "note": { "type": "string" }
      }
    },
    "stateItem": {
      "type": "object",
      "required": ["id", "path", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["id", "check", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "check": { "type": "string" },
        "severity": { "enum": ["hard", "standing"] },
        "rule": { "type": "string", "description": "Id of the instructions rule this policy enforces." },
        "description": { "type": "string" },
        "params": { "type": "object" }
      }
    }
  }
}
