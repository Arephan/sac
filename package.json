{
  "name": "setup-as-code",
  "private": true,
  "version": "0.2.0",
  "description": "Declarative, Terraform-style manifest for a personal AI assistant setup: import, plan, verify, apply.",
  "type": "module",
  "bin": {
    "setup": "./setup.mjs"
  },
  "scripts": {
    "init": "node setup.mjs init",
    "import": "node setup.mjs import",
    "validate": "node setup.mjs validate",
    "plan": "node setup.mjs plan",
    "verify": "node setup.mjs verify",
    "apply": "node setup.mjs apply",
    "lint": "node setup.mjs lint",
    "test": "node framework/selftest.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
